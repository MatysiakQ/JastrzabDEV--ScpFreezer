<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<Version>2.1.1</Version>
		<LangVersion>7.3</LangVersion>
		<ReferencesPath Condition="'$(ReferencesPath)' == ''">..\REFERENCES</ReferencesPath>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="tests\**\*.cs" />
	  <Reference Include="Assembly-CSharp">
	    <HintPath>$(ReferencesPath)\Assembly-CSharp.dll</HintPath>
	    <Private>false</Private>
	  </Reference>
	  <Reference Include="Assembly-CSharp-firstpass">
	    <HintPath>$(ReferencesPath)\Assembly-CSharp-firstpass.dll</HintPath>
	    <Private>false</Private>
	  </Reference>
	  <Reference Include="Exiled.API">
	    <HintPath>$(ReferencesPath)\Exiled.API.dll</HintPath>
	    <Private>false</Private>
	  </Reference>
	  <Reference Include="Exiled.Events">
	    <HintPath>$(ReferencesPath)\Exiled.Events.dll</HintPath>
	    <Private>false</Private>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
	    <HintPath>$(ReferencesPath)\UnityEngine.CoreModule.dll</HintPath>
	    <Private>false</Private>
	  </Reference>
	</ItemGroup>
</Project>
